# BluFleet Environment Configuration
# Copy this file to .env and update the values

# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/blufleet
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=blufleet
DATABASE_USER=username
DATABASE_PASSWORD=password
DATABASE_SSL=false

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# API Keys for service-to-service communication
API_KEYS=service-key-1,service-key-2

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET_NAME=blufleet-data
KINESIS_STREAM_NAME=blufleet-telemetry
IOT_ENDPOINT=your-iot-endpoint.amazonaws.com

# External Services
MAPBOX_ACCESS_TOKEN=your-mapbox-token
WEATHER_API_KEY=your-weather-api-key

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@blufleet.com

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Development Settings
DEV_BYPASS_AUTH=false
MOCK_EXTERNAL_SERVICES=true

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000
VITE_MAPBOX_TOKEN=your-mapbox-token
VITE_ENVIRONMENT=development