# BluFleet Backend Environment Configuration for Docker
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET="blufleet-dev-jwt-secret-2024-very-secure-key-change-in-production"
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Development Settings
DEV_BYPASS_AUTH=true
MOCK_EXTERNAL_SERVICES=false

# Database (Real PostgreSQL connection)
DATABASE_URL=postgresql://blufleet:blufleet_dev_password@postgres:5432/blufleet
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=blufleet
DATABASE_USER=blufleet
DATABASE_PASSWORD=blufleet_dev_password
DATABASE_SSL=false
